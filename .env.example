# Copy to .env. It is gitignored; never commit it. Every value here is a secret except
# OKTA_ORG_URL. A source whose variables are empty is skipped, and `finops sync` says so.

# Anthropic Admin API key (sk-ant-admin…): Console → Settings → Admin keys.
# Not the key applications use. Read access to usage and cost.
ANTHROPIC_ADMIN_KEY=

# OpenAI admin key: Organization settings → Admin keys. Not a project API key.
OPENAI_ADMIN_KEY=

# Okta: the organisation URL, and an API token that can read groups
# (Security → API → Tokens), created by an admin with a read-only role.
OKTA_ORG_URL=
OKTA_API_TOKEN=

# A Slack-compatible incoming webhook for alerts. Without it, alerts are printed.
SLACK_WEBHOOK_URL=
